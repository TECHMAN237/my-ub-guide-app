@import "tailwindcss";

:root {
  /* Taste direction: achromatic-ledger (app screens) — dealt 2026-11-03 */
  --ground: #f8f8f8;
  --surface: #ffffff;
  --raised: #eeeeee;
  --active: #eeeeee;
  --border: #e6e6e6;
  --rule: #f0f0f0;
  --control: #d4d4d4;
  --text: #0a0a0a;
  --muted: #6b6b6b;
  --faint: #8a8a8a;
  --primary: #141414;          /* near-black fill, white label */
  --accent: #1d5fbf;            /* the one data hue — main chart / signal only */
  --positive: #2e7d32;
  --negative: #c4242a;
  --warning: #92400e;
  --radius-card: 8px;
  --radius-control: 6px;
  --radius-chip: 4px;
  --gap: 16px;
  --card-pad: 20px;
  --pad: 24px;
  --font: "Geist", "Inter", system-ui, sans-serif;
  --fs-title: 24px;
  --fs-section: 16px;
  --fs-kpi: 30px;
  --fs-body: 14px;
  --fs-small: 12px;
}

@layer utilities {
  .pb-safe {
    padding-bottom: env(safe-area-inset-bottom, 0.5rem);
  }
}

html, body {
  background: var(--ground);
  color: var(--text);
  font-family: var(--font);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fadeIn {
  animation: fadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
