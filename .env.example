# =================================================================
# UB Compass — Environment Configuration
# =================================================================
#
# The assistant runs a free OpenRouter model.
# The key is read only on the server (Express dev server / Vercel
# functions) and is never exposed to the browser bundle.
# =================================================================

# Required. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# Primary model. Must be an OpenRouter id ("vendor/model"); ":free" is the free tier.
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# Optional: public URL used for OpenRouter attribution headers.
# APP_URL="http://localhost:3000"

# -----------------------------------------------------------------
# Legacy variable names still read as fallbacks (lower priority):
#   openrouter_api_key, GEMMA_API_KEY, gemma_api_key,
#   GEMINI_API_KEY, gemini_api_key
# Set OPENROUTER_API_KEY instead for new deployments.
# -----------------------------------------------------------------

# Voice: transcription uses the browser Web Speech API and speech
# synthesis uses the browser TTS engine. OpenRouter does not provide
# an audio-transcription endpoint, so no cloud voice key is needed.
# SPEECH_TO_TEXT_ENABLED="true"
# TEXT_TO_SPEECH_ENABLED="true"
# TRANSLATION_ENABLED="true"
